generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                 @id
  name                      String
  email                     String                 @unique
  emailNotificationsEnabled Boolean                @default(true)
  emailVerified             Boolean                @default(false)
  image                     String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  role                      String?
  banned                    Boolean?               @default(false)
  banReason                 String?
  banExpires                DateTime?
  accounts                  Account[]
  approvalActions           ApprovalAction[]       @relation("ActionActor")
  assignedSteps             ApprovalStep[]         @relation("StepReviewer")
  approverPositions         ApproverPositionUser[]
  concernMessages           ConcernMessage[]       @relation("ConcernMessageAuthor")
  officerThreads            ConcernThread[]        @relation("ConcernOfficer")
  reviewerThreads           ConcernThread[]        @relation("ConcernReviewer")
  notifications             Notification[]
  sapfActivityLogs          SAPFActivityLog[]      @relation("SapfActivityActor")
  sapfChangeRequests        SAPFChangeRequest[]    @relation("SapfChangeRequestRequester")
  reviewedSapfChanges       SAPFChangeRequest[]    @relation("SapfChangeRequestReviewer")
  sapfRequests              SAPFRequest[]          @relation("OfficerRequests")
  sessions                  Session[]
  tutorialProgress          UserTutorialProgress[]
  createdVenueBlocks        VenueBlock[]           @relation("VenueBlockCreator")

  @@map("user")
}

model UserTutorialProgress {
  id          String                 @id
  userId      String
  role        UserRole
  status      TutorialProgressStatus @default(STARTED)
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([status])
  @@map("user_tutorial_progress")
}

model EventSpace {
  id                String             @id
  name              String
  location          String
  capacity          Int
  description       String
  status            EventSpaceStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  image             Bytes?
  amenities         Amenity[]
  images            EventSpaceImage[]
  sapfRequestVenues SAPFRequestVenue[]
  venueBlocks       VenueBlock[]

  @@map("event_space")
}

model EventSpaceImage {
  id           String     @id
  eventSpaceId String
  data         Bytes
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  eventSpace   EventSpace @relation(fields: [eventSpaceId], references: [id], onDelete: Cascade)

  @@index([eventSpaceId])
  @@map("event_space_image")
}

model Amenity {
  id           String      @id
  name         String
  icon         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eventSpaceId String?
  eventSpace   EventSpace? @relation(fields: [eventSpaceId], references: [id])

  @@map("amenity")
}

model SAPFRequest {
  id                          String                  @id
  requestNumber               String                  @unique
  submissionKey               String?                 @unique
  officerId                   String
  title                       String
  organization                String
  departmentCategory          String?
  department                  String
  attendeeCount               String
  status                      SAPFRequestStatus       @default(DRAFT)
  currentStepOrder            Int?
  conflictWarning             Boolean                 @default(false)
  rejectionReason             String?
  modality                    String?
  programCourse               String?
  venue                       String?
  setting                     String?
  offCampAgree                String?
  personnelInCharge           String?
  activityType                String?
  attire                      String?
  scope                       String?
  program                     String?
  rationale                   String?
  objectives                  String?
  programFlow                 String?
  emergencyPlan               String?
  budget                      String?
  sourceOfBudget              String?
  budgetDetails               String?
  vehiclePassengers           String?
  foodPax                     String?
  roomVenueDetails            String?
  soundSystemQty              String?
  microphoneQty               String?
  lcdProjectorQty             String?
  longTableQty                String?
  chairsQty                   String?
  extraProvisions             String?
  otherSupport                String?
  otherDetails                String?
  parentsConsent              Boolean?
  hasAttachments              Boolean?
  academicInterruption        Boolean?
  academicInterruptionRemarks String?
  medicalExam                 Boolean?
  reportOfCompliance          Boolean?
  studentPersonnelRatio       String?
  conductedRemarks            String?
  cancelledRemarks            String?
  verificationToken           String?                 @unique
  approvedAt                  DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  approvalActions             ApprovalAction[]
  approvalSteps               ApprovalStep[]
  concernThreads              ConcernThread[]
  notifications               Notification[]
  activityLogs                SAPFActivityLog[]
  attachments                 SAPFAttachment[]
  changeRequests              SAPFChangeRequest[]
  coreValues                  SAPFCoreValue[]
  graduateAttributes          SAPFGraduateAttribute[]
  officer                     User                    @relation("OfficerRequests", fields: [officerId], references: [id], onDelete: Cascade)
  schedules                   SAPFRequestSchedule[]
  venues                      SAPFRequestVenue[]
  supportRequests             SAPFSupportRequest[]

  @@index([officerId])
  @@index([status])
  @@map("sapf_request")
}

model SAPFRequestSchedule {
  id        String      @id
  requestId String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime    @default(now())
  request   SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([startAt])
  @@map("sapf_request_schedule")
}

model SAPFRequestVenue {
  id           String      @id
  requestId    String
  eventSpaceId String
  createdAt    DateTime    @default(now())
  eventSpace   EventSpace  @relation(fields: [eventSpaceId], references: [id], onDelete: Cascade)
  request      SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, eventSpaceId])
  @@index([eventSpaceId])
  @@map("sapf_request_venue")
}

model SAPFAttachment {
  id        String      @id
  requestId String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  purpose   String      @default("SDS_CLEARANCE")
  createdAt DateTime    @default(now())
  request   SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([purpose])
  @@map("sapf_attachment")
}

model SAPFCoreValue {
  id        String      @id
  requestId String
  value     String
  createdAt DateTime    @default(now())
  request   SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, value])
  @@index([requestId])
  @@map("sapf_core_value")
}

model SAPFGraduateAttribute {
  id        String      @id
  requestId String
  value     String
  createdAt DateTime    @default(now())
  request   SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, value])
  @@index([requestId])
  @@map("sapf_graduate_attribute")
}

model SAPFSupportRequest {
  id        String      @id
  requestId String
  value     String
  createdAt DateTime    @default(now())
  request   SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, value])
  @@index([requestId])
  @@map("sapf_support_request")
}

model ApprovalStep {
  id            String             @id
  requestId     String
  stepOrder     Int
  position      ApproverPosition
  label         String
  reviewerId    String
  status        ApprovalStepStatus @default(PENDING)
  comment       String?
  actedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  actions       ApprovalAction[]
  request       SAPFRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer      User               @relation("StepReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  concernThread ConcernThread?

  @@unique([requestId, stepOrder])
  @@index([reviewerId])
  @@index([status])
  @@map("approval_step")
}

model ApprovalAction {
  id        String             @id
  requestId String
  stepId    String?
  actorId   String
  action    ApprovalActionType
  comment   String?
  createdAt DateTime           @default(now())
  actor     User               @relation("ActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  request   SAPFRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      ApprovalStep?      @relation(fields: [stepId], references: [id])

  @@index([requestId])
  @@index([actorId])
  @@map("approval_action")
}

model SAPFActivityLog {
  id          String      @id
  requestId   String
  actorId     String?
  action      String
  title       String
  description String?
  metadata    String?
  createdAt   DateTime    @default(now())
  actor       User?       @relation("SapfActivityActor", fields: [actorId], references: [id])
  request     SAPFRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([actorId])
  @@index([action])
  @@map("sapf_activity_log")
}

model SAPFChangeRequest {
  id                String                  @id
  requestId         String
  requestedById     String
  reviewedById      String?
  type              SAPFChangeRequestType
  status            SAPFChangeRequestStatus @default(PENDING)
  reason            String
  resolutionComment String?
  createdAt         DateTime                @default(now())
  reviewedAt        DateTime?
  request           SAPFRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedBy       User                    @relation("SapfChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy        User?                   @relation("SapfChangeRequestReviewer", fields: [reviewedById], references: [id])

  @@index([requestId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@map("sapf_change_request")
}

model ApproverPositionUser {
  id        String           @id
  userId    String
  position  ApproverPosition
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([position])
  @@map("approver_position_user")
}

model VenueBlock {
  id           String               @id
  eventSpaceId String?
  type         VenueBlockType        @default(UNIVERSITY_WIDE)
  title        String
  reason       String?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    User?                @relation("VenueBlockCreator", fields: [createdById], references: [id])
  eventSpace   EventSpace?          @relation(fields: [eventSpaceId], references: [id], onDelete: Cascade)
  schedules    VenueBlockSchedule[]

  @@index([eventSpaceId])
  @@map("venue_block")
}

model VenueBlockSchedule {
  id           String     @id
  venueBlockId String
  startAt      DateTime
  endAt        DateTime
  createdAt    DateTime   @default(now())
  venueBlock   VenueBlock @relation(fields: [venueBlockId], references: [id], onDelete: Cascade)

  @@index([venueBlockId])
  @@index([startAt])
  @@map("venue_block_schedule")
}

model Notification {
  id        String           @id
  userId    String
  requestId String?
  type      NotificationType @default(REQUEST)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  request   SAPFRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@map("notification")
}

model ConcernThread {
  id             String              @id
  requestId      String
  approvalStepId String              @unique
  officerId      String
  reviewerId     String
  status         ConcernThreadStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       ConcernMessage[]
  approvalStep   ApprovalStep        @relation(fields: [approvalStepId], references: [id], onDelete: Cascade)
  officer        User                @relation("ConcernOfficer", fields: [officerId], references: [id], onDelete: Cascade)
  request        SAPFRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer       User                @relation("ConcernReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([officerId])
  @@index([reviewerId])
  @@map("concern_thread")
}

model ConcernMessage {
  id        String        @id
  threadId  String
  authorId  String
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())
  author    User          @relation("ConcernMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  thread    ConcernThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@map("concern_message")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  title                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model SystemSettings {
  id          String   @id @default("SYSTEM")
  smtpHost    String   @default("smtp.gmail.com")
  smtpPort    Int      @default(465)
  smtpUser    String   @default("")
  smtpPass    String   @default("")
  senderEmail String   @default("")
  senderName  String   @default("Zerve")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum EventSpaceStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum VenueBlockType {
  UNIVERSITY_WIDE
  SYSTEM_MAINTENANCE
}

enum SAPFRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RETURNED_FOR_REVISION
  REJECTED
  APPROVED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  RETURNED
  REJECTED
  SKIPPED
}

enum ApprovalActionType {
  SUBMITTED
  RESUBMITTED
  APPROVED
  RETURNED
  REJECTED
  COMMENTED
  FINALIZED
  CANCELLED
}

enum ApproverPosition {
  ADVISER
  DEAN
  SDS
  SAS
  ADDITIONAL_SIGNATORY
  VPAA_ASSISTANT
  VPAA
  UNIVERSITY_PRESIDENT
}

enum ConcernThreadStatus {
  OPEN
  RESOLVED
}

enum NotificationType {
  REQUEST
  APPROVAL
  REVISION
  REJECTION
  CONFLICT
  FINAL
  COMMENT
}

enum SAPFChangeRequestType {
  EDIT
  CANCEL
}

enum SAPFChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  OFFICER
  APPROVER
  ADMIN
  SUPER_ADMIN
}

enum TutorialProgressStatus {
  STARTED
  COMPLETED
  CANCELLED
}
